{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "orchid",
  "homepage": "https://ui.shadcn.com",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "cn helper for Orchid UI components.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Orchid UI button with type, style, size, and split action.",
      "dependencies": ["@base-ui/react", "class-variance-authority", "lucide-react"],
      "registryDependencies": [],
      "files": [
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui",
          "target": "components/ui/button.tsx"
        }
      ]
    },
    {
      "name": "dropdown-menu",
      "type": "registry:ui",
      "title": "Dropdown Menu",
      "description": "Orchid UI dropdown menu built on Base UI.",
      "dependencies": ["@base-ui/react", "class-variance-authority", "lucide-react"],
      "registryDependencies": [],
      "files": [
        {
          "path": "src/components/ui/dropdown-menu.tsx",
          "type": "registry:ui",
          "target": "components/ui/dropdown-menu.tsx"
        }
      ]
    },
    {
      "name": "snackbar",
      "type": "registry:ui",
      "title": "Snack Bar",
      "description": "Orchid UI snackbar for floating toasts and rich banners.",
      "dependencies": ["class-variance-authority", "lucide-react"],
      "registryDependencies": [],
      "files": [
        {
          "path": "src/components/ui/snackbar.tsx",
          "type": "registry:ui",
          "target": "components/ui/snackbar.tsx"
        }
      ]
    }
  ]
}
